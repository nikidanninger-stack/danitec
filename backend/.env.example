# ─── Danitec Backend – Umgebungsvariablen ─────────────────────────
# Kopiere diese Datei als .env und fülle die Werte aus

# Server
NODE_ENV=development
PORT=3001

# PostgreSQL Datenbank
DB_HOST=localhost
DB_PORT=5432
DB_NAME=danitec_db
DB_USER=danitec_user
DB_PASSWORD=sicheres_passwort_hier

# JWT Auth
JWT_SECRET=dein_sehr_langer_zufaelliger_jwt_secret_mindestens_64_zeichen_lang
JWT_EXPIRES_IN=7d

# Datei-Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# E-Mail (SMTP)
SMTP_HOST=smtp.example.at
SMTP_PORT=587
SMTP_USER=office@danitec.at
SMTP_PASS=email_passwort
SMTP_FROM=office@danitec.at

# Frontend URL (für CORS)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

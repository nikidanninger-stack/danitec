# ─── Danitec Backend – Umgebungsvariablen ─────────────────────────
NODE_ENV=development
PORT=3001

# PostgreSQL Datenbank
DB_HOST=localhost
DB_PORT=5432
DB_NAME=danitec_db
DB_USER=danitec_user
DB_PASSWORD=Danitec2025!

# JWT Auth
JWT_SECRET=danitec_jwt_secret_sehr_lang_und_sicher_fuer_produktion_aendern_64z
JWT_EXPIRES_IN=7d

# Datei-Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# E-Mail (SMTP) – optional, App läuft auch ohne
SMTP_HOST=smtp.example.at
SMTP_PORT=587
SMTP_USER=office@danitec.at
SMTP_PASS=email_passwort
SMTP_FROM=office@danitec.at

# OpenAI API Key (für Foto-Erkennung von Eingangsrechnungen)
OPENAI_API_KEY=sk-hier-deinen-key-eintragen

# Frontend URL (für CORS)
FRONTEND_URL=http://localhost:3000

# Salt Edge Open Banking (Raiffeisen / BAWAG / etc.)
# Registrieren unter: https://www.saltedge.com/pages/dashboard_overview
# Nach Login: Dashboard → API Keys → App-id + Secret kopieren
SALTEDGE_APP_ID=22vIh9N_BsMxDCOXDrqX8rp2g499b2bhh769zi50miM
SALTEDGE_SECRET=OYRWxr7vtmTebB7xbRSSpaQedRd70eFEwf8_u-6EzpQ

# Google Drive OAuth2 (Google Cloud Console → APIs & Dienste → Anmeldedaten)
# Anleitung: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=HIER_CLIENT_ID_EINTRAGEN
GOOGLE_CLIENT_SECRET=HIER_CLIENT_SECRET_EINTRAGEN
GOOGLE_REDIRECT_URI=http://localhost:3001/api/drive/callback

# Logging
LOG_LEVEL=info
